    },
    "./search": {
      "types": "./search/dist/jb-icon-search.d.ts",
      "default": "./search/index.js"
    },
    "./*": "./*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/javadbat/jb-icon.git"
  }
