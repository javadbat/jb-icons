{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["DOM", "ES2022"],
    "strict": true,
    "rootDir": "./lib",
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationDir": "./dist",
    "skipLibCheck": true
  },
  "include": ["lib/**/*.ts"],
  "exclude": ["dist"]
}
